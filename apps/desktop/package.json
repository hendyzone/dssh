{
  "name": "dssh-desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "test": "vitest run",
    "test:desktop": "node --test electron/tests/*.test.cjs",
    "build": "tsc -b && vite build",
    "build:backend": "node scripts/build-backend.mjs",
    "start": "electron .",
    "pack": "npm run build && npm run build:backend && electron-builder --dir",
    "dist": "npm run build && npm run build:backend && electron-builder --publish never",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ghostty-web": "file:../../vendor/ghostty-web",
    "lucide-react": "^1.41.0",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "jsdom": "^26.1.0",
    "ssh2": "1.17.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  },
  "main": "electron/main.cjs",
  "description": "SSH workspace with terminals, files and remote development tools",
  "author": "dssh contributors",
  "build": {
    "appId": "dev.dssh.app",
    "productName": "dssh",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "electron/icons"
    },
    "files": [
      "dist/**/*",
      "electron/*.cjs",
      "electron/commands.json",
      "package.json",
      "electron/icons/icon.png"
    ],
    "extraResources": [
      {
        "from": "backend/target/release",
        "to": "backend",
        "filter": [
          "dssh-backend",
          "dssh-backend.exe"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "electron/icons/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "electron/icons",
      "category": "Development"
    }
  }
}
