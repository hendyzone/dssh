{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team.example.invalid/schemas/activity-state.json",
  "title": "Worker activity state file v1: activity/<box>.state.json (latest event record, atomically replaced, same shape as one activity-event.json line)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "ts",
    "box",
    "tool",
    "ev",
    "pane"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "ts": {
      "$ref": "#/$defs/timestamp"
    },
    "box": {
      "type": "string",
      "minLength": 1,
      "maxLength": 254
    },
    "tool": {
      "enum": [
        "claude",
        "codex",
        "cursor",
        "pi",
        "dsh",
        "agy"
      ]
    },
    "ev": {
      "$ref": "#/$defs/activityEventName"
    },
    "sid": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "turn": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "pane": {
      "type": "string",
      "pattern": "^%[0-9]+$"
    },
    "pid": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "ok": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "detail": {
      "type": "string",
      "maxLength": 80
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "activityEventName": {
      "enum": [
        "session_start",
        "turn_start",
        "model_start",
        "model_end",
        "tool_start",
        "tool_end",
        "wait_human",
        "idle_notice",
        "turn_end",
        "turn_error",
        "compact",
        "session_end"
      ]
    }
  }
}
